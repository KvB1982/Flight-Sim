{
  "name": "flugsim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flugsimulator als iPad- und iPhone-App (Capacitor)",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "sync": "node scripts/copy-web.mjs && cap sync ios",
    "ios": "node scripts/copy-web.mjs && cap sync ios && cap open ios",
    "testflight": "bash scripts/testflight.sh"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "peerjs": "1.5.4",
    "qrcode-generator": "1.4.4"
  }
}
